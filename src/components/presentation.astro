---
import slidesSvg from '../assets/slides.svg';
import videoSvg from '../assets/youtube.svg';

interface Props {
  title: string;
  slides: string;
  video?: string;
  description: string;
}
const { title, slides, video, description } = Astro.props;
---

<article class={`flex flex-col md:flex-row items-start md:items-center 
space-x-4 md:space-x-6 px-4 py-3 border-l-4 border-gray-600 
transition-all duration-300 ease-in-out w-full
hover:border-gray-400 hover:bg-gray-800/80 hover:shadow-xl hover:shadow-black`}>
  <p class="flex items-center space-x-4 flex-shrink-0 pb-2 md:pb-0">
    <a href={slides} target="_blank" class="hover:shadow-2xl hover:shadow-white transition-opacity">
      <img class="h-8" src={slidesSvg.src} />
    </a>
    {video && (
      <a href={video} target="_blank" class="hover:shadow-2xl hover:shadow-white transition-opacity">
      <img class="h-8" src={videoSvg.src} />
      </a>
    )}
  </p>
  <div class="flex-1 min-w-0 flex flex-col">
    <p class="font-bold text-gray-200 mb-2">
      {title}
    </p>
    <p class="text-gray-400 text-sm md:text-base text-justify">
      {description}
    </p>
  </div>
</article>
