---
import me from '../assets/mihail-mikov.jpg';
import github from '../assets/github.svg';
import linkedin from '../assets/linkedin.svg';
import bgg from '../assets/bgg.svg';
import juggling from '../assets/juggling.svg';
import theatre from '../assets/theatre.svg';
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 bg-gray-800 text-gray-300 transition-all duration-500 ease-in-out"
>
  <div class="header-content p-4 mx-auto lg:pt-6 max-w-6xl">
    <div class="header-full flex flex-col lg:flex-row items-center justify-between gap-4">
      <div class="flex flex-row items-center">
        <img
          class="rounded-lg mr-6 shadow-lg hover:shadow-gray-500/40 hover:scale-105 transition-all duration-300"
          src={me.src}
          width="64"
          height="64"
          alt="Mihail Mikov (me)"
        />
        <div class="flex flex-col">
          <h1 class="text-xl font-bold text-white">
            Hi, I'm Misho
          </h1>
          <p class="text-xs text-gray-400">
            software engineer | board game geek | juggler
          </p>
        </div>
      </div>
      <input id="menu-btn" type="checkbox" class="hidden" />
      <label for="menu-btn" class="block md:hidden"><span class="text-3xl"> ☰</span></label>
      <nav class="menu hidden md:flex flex-col md:flex-row items-center gap-2">
        <a href="/#about-me" class="px-3 py-1.5 text-sm bg-gray-700 hover:bg-gray-600 rounded-md text-white transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
          About Me
        </a>
        <a href="/#presentations" class="px-3 py-1.5 text-sm bg-gray-700 hover:bg-gray-600 rounded-md text-white transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
          Presentations
        </a>
        <a href="/#courses" class="px-3 py-1.5 text-sm bg-gray-700 hover:bg-gray-600 rounded-md text-white transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
          Courses
        </a>
        <a href="/blog" class="px-3 py-1.5 text-sm bg-gray-700 hover:bg-gray-600 rounded-md text-white transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
          Blog
        </a>
        <div class="flex flex-row gap-2 ml-2">
          <a href="https://github.com/debel" class="p-1.5 bg-gray-700 hover:bg-gray-600 rounded-md transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 transform hover:scale-110">
            <img class="h-4 w-4" src={github.src} />
          </a>
          <a href="https://bg.linkedin.com/in/mihail-mikov-baa68a108" class="p-1.5 bg-gray-700 hover:bg-gray-600 rounded-md transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 transform hover:scale-110">
            <img class="h-4 w-4" src={linkedin.src} />
          </a>
          <a href="https://boardgamegeek.com/collection/user/debelbot?gallery=large&sort=rating&sortdir=desc&rankobjecttype=subtype&rankobjectid=1&columns=title%7Cstatus%7Cversion%7Crating%7Cbggrating%7Cplays%7Ccomment%7Ccommands&excludesubtype=boardgameexpansion&own=1&objecttype=thing&ff=1&subtype=boardgame" class="p-1.5 bg-gray-700 hover:bg-gray-600 rounded-md transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 transform hover:scale-110">
            <img class="h-4 w-4" src={bgg.src} />
          </a>
          <a href="#" class="p-1.5 bg-gray-700 hover:bg-gray-600 rounded-md transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 transform hover:scale-110">
            <img class="h-4 w-4" src={juggling.src} />
          </a>
          <a href="#" class="p-1.5 bg-gray-700 hover:bg-gray-600 rounded-md transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 transform hover:scale-110">
            <img class="h-4 w-4" src={theatre.src} />
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
 #menu-btn:checked ~ .menu {
   display: flex;
 }
</style>

<script>
const menuBtn = document.querySelector('#menu-btn')
document.addEventListener("click", (e) => {
  if (e.target.matches('.menu>a')) {
    menuBtn.checked = false
  }
})
</script>
