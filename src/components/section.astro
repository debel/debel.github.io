---

export type Props = {
  title: string;
}

const { title } = Astro.props;

const sectionId = title.toLowerCase().replaceAll(' ', '-');
---

<section id={sectionId} class="w-full flex flex-col bg-gray-900 text-gray-300 xl:rounded-lg p-4 xl:border border-gray-700 shadow-2xl">
  <h2 class="p-2 text-2xl rounded-t-md mb-2 transition-colors">
    <span class="font-bold text-white">{title}</span>
  </h2>
  <slot />
</section>
