---
import Section from './section.astro';
import Job from './job.astro';

import jobs from '../data/jobs.js';
---

<Section title="About me">
  <article>
    <p class="p-2 italic border-l-4 border-gray-500 bg-gray-800/50 px-4 rounded-r-md">
      a software engineer with a graying beard; a proud father and husband; a sci-fi addict
    </p>
    <p class="p-2 text-justify lg:text-left italic border-l-4 border-gray-500 bg-gray-800/50 px-4 rounded-r-md">
      I enjoy all aspects of programming and computer science. I'm always interested in learning new things, exploring cool tech and working with amazing people. 
    </p>
  </article>
  <article class="mt-4">
    <h3 class="text-xl pl-2 bg-gray-700 mb-2 px-4 py-2 rounded text-white">Interests</h3>
    <div class="md:grid space-y-2 md:grid-cols-2 ml-2 gap-2 m-0 auto flex flex-col">
      <ul class="list-disc list-inside space-y-1">
        <li>Distributed systems</li>
        <li>Language design</li>
        <li>Teaching & mentoring</li>
      </ul>
      <ul class="list-disc list-inside space-y-1">
        <li>Board game design</li>
        <li>Theatre directing & acting</li>
        <li>Hiking & juggling</li>
      </ul>
    </div>
  </article>
  <article>
    <h3 class="text-xl pl-2 bg-gray-700 mt-2 mb-2 px-4 py-2 rounded text-white">Job history</h3>
    {jobs.map(j => <Job {...j} />)}
  </article>
</Section>
